# Copy this file to .env and fill in both values from your Supabase project:
# Project Settings → API (or the "Connect" dialog).
VITE_SUPABASE_URL=

# The publishable key (starts with sb_publishable_). This is safe in the browser;
# Row Level Security is what protects your data.
# Older projects can use VITE_SUPABASE_ANON_KEY with the legacy anon key instead.
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the secret or service_role key here. Anything starting with VITE_ is
# bundled into public JavaScript, and that key bypasses all security rules.
