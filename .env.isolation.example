# For `npm run verify:isolation`. Copy to .env.isolation (it is git-ignored).
# Use two throwaway test users. Never use your real account: the script creates and
# deletes records. See docs/SUPABASE_SETUP.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
